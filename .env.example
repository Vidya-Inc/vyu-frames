# Token from @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# ID of your private channel (negative number, e.g. -1001234567890)
TELEGRAM_CHAT_ID=-1001234567890

# PIN to unlock /admin (change this!)
ADMIN_PIN=150106

# Long random string used to sign the admin session cookie
SESSION_SECRET=change_this_to_a_long_random_string
